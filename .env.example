# Copy to .env (git-ignored). Load with: set -a; source .env; set +a
DRUG_SAFE_ENV=dev
GCP_PROJECT=your-gcp-project-id
# Local path for dev, or gs://<project>-raw-dev for cloud runs
DRUG_SAFE_RAW_ROOT=./data/raw
# Optional: raises openFDA rate limits. Free key at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
DRUG_SAFE_ACTOR=your-name
